<?xml version="1.0"?>
<ruleset name="WireCore REST Control">
	<description>PHP compatibility check for the minimum supported PHP version.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/db-data/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<!-- Keep in sync with "Requires PHP" in the plugin header and readme.txt. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
