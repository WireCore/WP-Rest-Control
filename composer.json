{
	"name": "wirecore/wp-rest-control",
	"description": "Disables the WordPress REST API selectively – globally, per namespace or per route, including routes of other plugins.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"rest-api",
		"security"
	],
	"homepage": "https://wordpress.org/plugins/wirecore-rest-control/",
	"authors": [
		{
			"name": "WireCore GmbH",
			"homepage": "https://wirecore.net"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "*",
		"wp-phpunit/wp-phpunit": "*",
		"roots/wordpress-no-content": "*",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.33"
		}
	},
	"scripts": {
		"phpcs": "phpcs",
		"test": "phpunit"
	}
}
